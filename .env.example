# Copy to .env (same folder as riskaware.yaml) or ~/.riskaware/.env and fill in what you use.
# 复制为 .env，只填你用到的券商。不要把 .env 提交到 git。

# Alpaca (paper keys start with PK) / Alpaca 模拟盘 key 以 PK 开头
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Public.com (live only, no paper environment) / Public 只有实盘
PUBLIC_API_SECRET=
PUBLIC_ACCOUNT_ID=

# Tradier (sandbox token for paper) / Tradier 沙盒
TRADIER_TOKEN=
TRADIER_ACCOUNT_ID=

# Interactive Brokers: start TWS / IB Gateway; paper port 7497 (TWS) or 4002 (Gateway)
IBKR_PORT=7497
IBKR_ACCOUNT=

# Charles Schwab (developer.schwab.com app)
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# tastytrade OAuth
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=

# Futu / moomoo: run OpenD locally; only needed for real (non-simulated) trading / 富途牛牛：实盘才需要交易密码
FUTU_TRADE_PASSWORD=

# Longbridge / 长桥
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_ACCESS_TOKEN=

# Tiger Brokers: put tiger_openapi_config.properties in ~/.riskaware/tiger / 老虎证券配置文件

# Optional LLM review / 可选的 LLM 复核
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional notifications / 可选通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
