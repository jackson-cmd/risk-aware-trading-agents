{
  "name": "Risk-Aware Trading Agents",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12",
  "postCreateCommand": "pip install -e \".[dashboard,mcp,llm,dev]\"",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Dashboard", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
